{
  "name": "lakana-ui",
  "private": true,
  "description": "The web interface of Lakana. Its build ships inside the lakana-server wheel.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "Firefox ESR",
    "last 2 Safari versions"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "preview": "vite preview",
    "size": "size-limit",
    "e2e:smoke": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:server": "playwright test -c playwright.server.config.ts",
    "prove-gates": "node scripts/prove-gates.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run depcruise && npm run knip && npm run test:coverage && npm run build && npm run size"
  },
  "dependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@size-limit/file": "14.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "browserslist": "4.29.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "size-limit": "14.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@^10": "11.0.5"
  }
}
