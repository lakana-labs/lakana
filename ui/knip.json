{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "build/*.ts",
    "scripts/*.mjs",
    "e2e/**/*.spec.ts",
    "e2e-server/**/*.spec.ts",
    "*.config.ts",
    "csp.ts",
    "public/theme-boot.js"
  ],
  "project": ["src/**/*.{ts,tsx}", "build/**/*.ts", "e2e/**/*.ts", "e2e-server/**/*.ts"],
  "ignoreDependencies": ["@ibm/plex-sans", "@ibm/plex-mono"]
}
