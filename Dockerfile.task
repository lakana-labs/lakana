# syntax=docker/dockerfile:1
# A Lakana task image: the Python a project's Python tasks run on, uv, the build entry the
# launcher runs and the connection check with its drivers. One image per supported Python, built
# by the release workflow from the repository root with
#   uv export --frozen --only-group check --no-emit-workspace -o dist/check-requirements.txt
#   docker build -f Dockerfile.task --build-arg PYTHON=3.14 -t ghcr.io/lakana-labs/lakana-task:<version>-py3.14 .
# (the first writes the check environment's packages with their hashes from uv.lock).
# The image has no entry point: the launcher sets every container's command.
ARG PYTHON=3.14

# uv, pinned by tag and digest as in Dockerfile; test_dockerfile.py keeps both pins equal.
FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

# The Python bases, pinned by tag and digest like Dockerfile's (Dependabot bumps both; it cannot
# bump a `FROM` that takes its tag from an ARG, so each version has a stage of its own).
FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535 AS py3.11
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS py3.12
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS py3.13
FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f AS py3.14

FROM py${PYTHON}
# zlib1g: the security fix (CVE-2026-85091, CVE-2026-76844) is newer than the base digests
# above, as in Dockerfile; only the named package, and the build fails below the fixed version.
RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade zlib1g \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' zlib1g)" ge 1:1.3.dfsg+really1.3.1-1+deb13u1 \
 && rm -rf /var/lib/apt/lists/*
# uid 10001 runs tasks (the worker's uid: the harness must own its work directory) in group
# 10003, which is not the worker's group 10001; uid 10002 builds environments, so a task cannot
# change the files of the environment it runs in. /env and /uv-cache give a new volume the
# build user as owner on first use.
RUN groupadd --system --gid 10003 lakana-task \
 && useradd --system --uid 10001 --gid lakana-task --no-create-home --home-dir /work/home --shell /usr/sbin/nologin lakana \
 && groupadd --system --gid 10002 lakana-build \
 && useradd --system --uid 10002 --gid lakana-build --no-create-home --home-dir /tmp --shell /usr/sbin/nologin lakana-build \
 && install -d -o 10002 -g 10002 -m 0755 /env \
 && install -d -o 10002 -g 10002 -m 0700 /uv-cache \
 && install -d -m 0755 /code /work /src /opt/lakana-task /ingest /trust
COPY --from=uv /uv /usr/local/bin/uv
COPY packages/lakana-worker/src/lakana_worker/launcher/task_build.py /opt/lakana-task/build.py
# The connection check: Lakana's own module, one file, never a project's code; `lakana connection
# test` runs it as the launcher's check op does, on the check environment's Python. The
# environment holds exactly the drivers its credential steps import (the `check` group of
# uv.lock, by hash, wheels only): no lakana, no pyarrow. Root's and read-only, so a task cannot
# change it; installed before the setuid strip below. The build runs the check once.
COPY dist/check-requirements.txt /opt/lakana-check/requirements.txt
COPY packages/lakana/src/lakana/ingest/_check.py /opt/lakana-check/check.py
RUN UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=never uv venv --python /usr/local/bin/python /opt/lakana-check-env \
 && UV_NO_CACHE=1 uv pip install --python /opt/lakana-check-env/bin/python --require-hashes --no-deps \
    --only-binary :all: -r /opt/lakana-check/requirements.txt \
 && chown -R 0:0 /opt/lakana-check /opt/lakana-check-env \
 && chmod -R a-w,a+rX /opt/lakana-check /opt/lakana-check-env \
 && /opt/lakana-check-env/bin/python -I -B -c 'import adbc_driver_postgresql.dbapi, adbc_driver_sqlite.dbapi, cryptography, pymysql' \
 && echo '{"connection": {"kind": "none"}}' | /opt/lakana-check-env/bin/python -I -B /opt/lakana-check/check.py \
  | grep -q 'does not know the kind'
# No file keeps a setuid or setgid bit: where Docker refuses no-new-privileges (snap), `su` or
# `mount` would make a task's process uid 0 again. Last, so nothing installed above keeps one.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +
USER 10001:10003
